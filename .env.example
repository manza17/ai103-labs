# Copiar este archivo como .env dentro de la carpeta del lab y completar.
# El .env NO se sube al repo.

# Endpoint del proyecto de Foundry (Overview del proyecto)
PROJECT_ENDPOINT=https://<recurso>.services.ai.azure.com/api/projects/<proyecto>

# Endpoint OpenAI v1 (solo si el lab usa el SDK de OpenAI directo)
OPENAI_ENDPOINT=https://<recurso>.openai.azure.com/openai/v1/

# Nombre del deployment (va en el parámetro model). Usar siempre un modelo mini.
MODEL_DEPLOYMENT=gpt-4.1-mini
